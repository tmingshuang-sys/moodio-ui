{
  "name": "moodio-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort false",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 5174",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gateway:login": "wrangler login --config gateway/wrangler.toml",
    "gateway:deploy": "wrangler deploy --config gateway/wrangler.toml",
    "gateway:dev": "wrangler dev --config gateway/wrangler.toml",
    "site:build": "npm run check && npm run build",
    "site:deploy": "npm run site:build && wrangler deploy --config site/wrangler.toml"
  },
  "dependencies": {
    "idb-keyval": "latest",
    "lucide-react": "latest",
    "mp4-muxer": "^5.2.2",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.131.1"
  }
}
