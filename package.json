{
  "name": "moodio-ui",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "serve": "python3 -m http.server 8765",
    "gateway:login": "wrangler login --config gateway/wrangler.toml",
    "gateway:deploy": "wrangler deploy --config gateway/wrangler.toml",
    "gateway:dev": "wrangler dev --config gateway/wrangler.toml",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "site:build": "node scripts/build.mjs && node --check dist/src/app.js",
    "site:deploy": "npm run check && npm run site:build && wrangler deploy --config site/wrangler.toml",
    "check": "for f in src/*.js; do node --check \"$f\" || exit 1; done && echo \"js ok\""
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "wrangler": "^4.131.1"
  }
}
