# 复制成 .env 再填。真实 key 不要进仓库（.env* 已经 gitignore）。
PORT=8787

# 页面来源白名单，逗号分隔；留空 = 允许所有（只在本机开发时这样）
ALLOWED_ORIGINS=https://wow.moodio.art,https://moodio-ui.moodio-ui.workers.dev,http://localhost:5174

# 网关口令：页面「模型设置」里填在 API Key 那一栏
ACCESS_TOKEN=

# 模型上游（和原来 Cloudflare Worker 里的 secret 同名同值）
DEEPSEEK_API_KEY=
KIMI_API_KEY=
FAL_KEY=
ARK_API_KEY=
BYTEPLUS_API_KEY=

# 数据库：不填的话只有网关能用，数据与渲染接口返回 503
DATABASE_URL=postgres://wow:wow@127.0.0.1:5433/wow

# 对象存储：留空用本机磁盘（server/blobs/）；线上填阿里云 OSS。
# 这些也都能在网页「服务器设置 → 媒体存储」里填，库里的优先；两把 key 给只管这一个 bucket 的 RAM 子账号
# OSS_BUCKET=
# OSS_REGION=oss-cn-hongkong
# OSS_ENDPOINT=                      # 可选；bucket 与服务器同区域时填 oss-cn-hongkong-internal.aliyuncs.com（内网，不计流量）
# OSS_ROLE=WowOssRole                # 推荐：给 ECS 挂一个有 OSS 权限的 RAM 角色，填角色名，机器自己领临时凭证，哪里都不存密钥
# OSS_ACCESS_KEY_ID=                 # 没有实例角色时才填这两项
# OSS_ACCESS_KEY_SECRET=

# 注册邀请码：留空 = 不开放注册。也能在网页「服务器设置 → 账号」里设
# INVITE_CODE=
